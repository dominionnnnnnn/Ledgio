rules_version = '2';

// Ledgio — Firestore security rules
//
// Data layout
//   users/{uid}                                   { email, name, businessId, createdAt }
//   businesses/{bizId}                            { name, type, currency, logoUrl, ownerId, plan,
//                                                   workerCount, lastWorkerId, fields, required,
//                                                   createdAt, updatedAt }
//   businesses/{bizId}/workers/{workerId}         { name, phone, role, truck, photoUrl, active, ... }
//   businesses/{bizId}/records/{recordId}         { workerId, workerName, truck, date, month, revenue,
//                                                   expense, values, createdBy, ... }
//   businesses/{bizId}/usage/{YYYY-MM}            { count, lastRecordId }
//   businesses/{bizId}/tickets/{ticketId}         { subject, category, status, screenshotUrl, ... }
//   businesses/{bizId}/tickets/{id}/messages/{m}  { from, text, createdAt }
//   businesses/{bizId}/notifications/{id}         { kind, title, body, unread, ... }
//
// Limits: the app writes a worker together with a workerCount increment, and a record
// together with a usage-counter increment, in one batch. The counter rules refuse the
// batch once the plan limit is reached, so the limits hold even if someone skips the UI.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    // Reserved for the admin app (set via a custom claim later).
    function isAdmin() { return signedIn() && request.auth.token.get('admin', false) == true; }

    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function bizPath(bizId) { return /databases/$(database)/documents/businesses/$(bizId); }
    function workerPath(bizId, wid) { return /databases/$(database)/documents/businesses/$(bizId)/workers/$(wid); }
    function recordPath(bizId, rid) { return /databases/$(database)/documents/businesses/$(bizId)/records/$(rid); }
    function usagePath(bizId, month) { return /databases/$(database)/documents/businesses/$(bizId)/usage/$(month); }

    function isOwner(bizId) { return signedIn() && get(bizPath(bizId)).data.ownerId == request.auth.uid; }

    // Plan limits. "premium" can only be set by an admin, never by the user.
    function workerLimit(plan) { return plan == 'free' ? 3 : 100000; }
    function recordLimit(plan) { return plan == 'free' ? 50 : 1000000; }

    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    function validImage(u) {
      return u is string && u.size() < 500 && u.matches('^https://res[.]cloudinary[.]com/.+');
    }
    function optionalImage(d, key) {
      return d.get(key, null) == null || validImage(d.get(key, null));
    }
    function shortText(v, max) { return v is string && v.size() <= max; }

    // ---------- users ----------
    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();

      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['email', 'name', 'businessId', 'createdAt'])
        && request.resource.data.get('businessId', null) == null;

      // businessId can be set exactly once, in the same batch that creates the business.
      allow update: if isSelf(uid)
        && changedOnly(['name', 'businessId'])
        && (
          request.resource.data.get('businessId', null) == resource.data.get('businessId', null)
          || (
            resource.data.get('businessId', null) == null
            && request.resource.data.businessId is string
            && !exists(bizPath(request.resource.data.businessId))
            && getAfter(bizPath(request.resource.data.businessId)).data.ownerId == uid
          )
        );

      allow delete: if false;
    }

    // ---------- businesses ----------
    function validBusiness(d) {
      return d.keys().hasOnly(['name', 'type', 'currency', 'logoUrl', 'ownerId', 'plan',
                               'workerCount', 'lastWorkerId', 'fields', 'required',
                               'createdAt', 'updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && shortText(d.type, 40)
        && d.currency in ['NGN', 'GHS', 'USD']
        && optionalImage(d, 'logoUrl')
        && d.workerCount is int && d.workerCount >= 0
        && d.fields is list && d.fields.size() <= 20
        && d.required is map && d.required.size() <= 20;
    }

    // workerCount may only move by one, and only alongside the matching worker create/delete.
    function workerCountOk(bizId) {
      let before = resource.data.workerCount;
      let after = request.resource.data.workerCount;
      let wid = request.resource.data.get('lastWorkerId', 'none');
      return after == before
        || (after == before + 1
            && after <= workerLimit(resource.data.plan)
            && !exists(workerPath(bizId, wid))
            && existsAfter(workerPath(bizId, wid)))
        || (after == before - 1
            && exists(workerPath(bizId, wid))
            && !existsAfter(workerPath(bizId, wid)));
    }

    match /businesses/{bizId} {
      allow read: if (signedIn() && resource.data.ownerId == request.auth.uid) || isAdmin();

      // One business per user: the user's businessId must be empty now and point here after.
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.plan == 'free'
        && request.resource.data.workerCount == 0
        && validBusiness(request.resource.data)
        && get(userPath(request.auth.uid)).data.get('businessId', null) == null
        && getAfter(userPath(request.auth.uid)).data.businessId == bizId;

      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.plan == resource.data.plan
        && request.resource.data.createdAt == resource.data.createdAt
        && validBusiness(request.resource.data)
        && workerCountOk(bizId);

      allow delete: if false;

      // ---------- workers ----------
      function validWorker(d) {
        return d.keys().hasOnly(['name', 'phone', 'role', 'truck', 'photoUrl', 'active',
                                 'createdAt', 'updatedAt'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 80
          && shortText(d.get('phone', ''), 20)
          && shortText(d.get('role', ''), 40)
          && shortText(d.get('truck', ''), 30)
          && optionalImage(d, 'photoUrl')
          && d.active is bool;
      }

      match /workers/{workerId} {
        allow read: if isOwner(bizId);

        allow create: if isOwner(bizId)
          && validWorker(request.resource.data)
          && getAfter(bizPath(bizId)).data.workerCount == get(bizPath(bizId)).data.workerCount + 1
          && getAfter(bizPath(bizId)).data.lastWorkerId == workerId;

        allow update: if isOwner(bizId) && validWorker(request.resource.data);

        allow delete: if isOwner(bizId)
          && getAfter(bizPath(bizId)).data.workerCount == get(bizPath(bizId)).data.workerCount - 1
          && getAfter(bizPath(bizId)).data.lastWorkerId == workerId;
      }

      // ---------- records ----------
      // month = the YYYY-MM of the record's date. It is the usage bucket, so it can't change.
      // Profit = revenue - expense. workerName is a copy so records keep the name if the worker is deleted.
      function validRecord(d) {
        return d.keys().hasOnly(['workerId', 'workerName', 'truck', 'date', 'month', 'revenue', 'expense',
                                 'values', 'createdBy', 'createdAt', 'updatedAt'])
          && d.workerId is string
          && d.workerName is string && d.workerName.size() <= 80
          && shortText(d.get('truck', ''), 30)
          && d.month is string && d.month.matches('^[0-9]{4}-[0-9]{2}$')
          && d.date is string && d.date.matches(d.month + '-[0-9]{2}')
          && d.revenue is number && d.revenue >= 0
          && d.expense is number && d.expense >= 0
          && d.values is map && d.values.size() <= 20;
      }

      match /records/{recordId} {
        allow read: if isOwner(bizId);

        allow create: if isOwner(bizId)
          && validRecord(request.resource.data)
          && exists(workerPath(bizId, request.resource.data.workerId))
          && request.resource.data.createdBy == request.auth.uid
          && getAfter(usagePath(bizId, request.resource.data.month)).data.lastRecordId == recordId;

        // Old records of a deleted worker can still be edited as long as the worker isn't changed.
        allow update: if isOwner(bizId)
          && validRecord(request.resource.data)
          && (request.resource.data.workerId == resource.data.workerId
              || exists(workerPath(bizId, request.resource.data.workerId)))
          && request.resource.data.month == resource.data.month
          && request.resource.data.createdBy == resource.data.createdBy;

        // Deleting a record does not give the monthly quota back.
        allow delete: if isOwner(bizId);
      }

      // ---------- monthly usage counter ----------
      match /usage/{month} {
        allow read: if isOwner(bizId);

        allow create: if isOwner(bizId)
          && month.matches('^[0-9]{4}-[0-9]{2}$')
          && request.resource.data.keys().hasOnly(['count', 'lastRecordId'])
          && request.resource.data.count == 1
          && !exists(recordPath(bizId, request.resource.data.lastRecordId))
          && getAfter(recordPath(bizId, request.resource.data.lastRecordId)).data.month == month;

        allow update: if isOwner(bizId)
          && request.resource.data.keys().hasOnly(['count', 'lastRecordId'])
          && request.resource.data.count == resource.data.count + 1
          && request.resource.data.count <= recordLimit(get(bizPath(bizId)).data.plan)
          && !exists(recordPath(bizId, request.resource.data.lastRecordId))
          && getAfter(recordPath(bizId, request.resource.data.lastRecordId)).data.month == month;

        allow delete: if false;
      }

      // ---------- support tickets ----------
      match /tickets/{ticketId} {
        allow read: if isOwner(bizId) || isAdmin();

        allow create: if isOwner(bizId)
          && request.resource.data.keys().hasOnly(['subject', 'category', 'status', 'ref',
                                                   'screenshotUrl', 'createdBy', 'createdAt', 'updatedAt'])
          && request.resource.data.subject is string
          && request.resource.data.subject.size() > 0 && request.resource.data.subject.size() <= 140
          && shortText(request.resource.data.category, 40)
          && request.resource.data.status == 'open'
          && request.resource.data.createdBy == request.auth.uid
          && optionalImage(request.resource.data, 'screenshotUrl');

        // The user can close or reopen; "answered" is set by support (admin).
        allow update: if isAdmin()
          || (isOwner(bizId)
              && changedOnly(['status', 'updatedAt'])
              && request.resource.data.status in ['open', 'closed']);

        allow delete: if false;

        match /messages/{messageId} {
          allow read: if isOwner(bizId) || isAdmin();
          allow create: if isAdmin()
            || (isOwner(bizId)
                && request.resource.data.keys().hasOnly(['from', 'text', 'createdAt'])
                && request.resource.data.from == 'user'
                && request.resource.data.text is string
                && request.resource.data.text.size() > 0
                && request.resource.data.text.size() <= 2000);
          allow update, delete: if false;
        }
      }

      // ---------- in-app notifications ----------
      match /notifications/{notifId} {
        allow read, delete: if isOwner(bizId);
        allow create: if isOwner(bizId) || isAdmin();
        allow update: if isOwner(bizId) && changedOnly(['unread']);
      }
    }
  }
}
